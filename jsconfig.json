{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "src/core/**/*.js",
    "src/presets/**/*.js",
    "src/providers/registry.js",
    "src/providers/adapters/**/*.js",
    "src/auto-translation/state-machine.js",
    "src/auto-translation/cooldown-store.js",
    "src/auto-translation/task-state.js",
    "src/auto-translation/translation-renderer.js",
    "src/auto-translation/channel-rule.js",
    "src/composer/composer-writer.js",
    "src/settings/settings-schema.js",
    "src/discord/**/*.js",
    "src/intake/emoji-text.js"
  ]
}
