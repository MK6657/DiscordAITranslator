{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "src/core/**/*.js",
    "src/presets/**/*.js",
    "src/discord/selectors.js",
    "src/discord/stores.js",
    "src/discord/host-health.js",
    "src/discord/host-adapter.js",
    "src/auto-translation/channel-rule.js",
    "src/intake/emoji-text.js"
  ]
}
