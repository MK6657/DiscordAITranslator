# Dependencies and generated test output
/node_modules/
/dist/
/coverage/
/outputs/
/logs/
/work/
DiscordAITranslator-handoff-*.zip
*.zip
*.7z
*.tar.gz
/.cache/
/.tmp/

# Local configuration and secrets
.env
.env.*
!.env.example
*.local.json

# Installer/runtime artifacts
*.bak-*
*.tmp-*
*.log

# Local reverse-engineering/reference checkout (GPL-2.0; not part of this project)
/external/

# Local agent state
/.agents/
/.claude/

# Local browser profiles (headless Chrome/Edge user-data folders used for previews and smoke tests)
/.chrome-*/
/.chromium-*/
/.edge-*/
/.browser-profile*/
# Store names such as History, Cookies or Local State are deliberately not ignored anywhere else: a
# profile outside the folders above is then staged whole, so scripts/release-guards.js sees its login,
# cookie and history stores and blocks the release, instead of the rest of the profile slipping through.

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
